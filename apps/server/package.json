{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "@vox-flow/api": "workspace:*",
    "@vox-flow/auth": "workspace:*",
    "@vox-flow/db": "workspace:*",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^26.4.1",
    "@vox-flow/config": "workspace:*",
    "@vox-flow/infra": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
