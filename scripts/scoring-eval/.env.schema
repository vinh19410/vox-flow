# @defaultRequired=true
# @defaultSensitive=true
# ---

# Azure Speech Service (Direction A)
# @type=string(minLength=16)
AZURE_SPEECH_KEY=

# @type=string(minLength=2)
AZURE_SPEECH_REGION=

# OpenAI API for Whisper standalone ASR (Direction B default)
# @type=string(minLength=16)
OPENAI_API_KEY=

# SpeechSuper IELTS Speaking API (Direction B)
# @type=string(minLength=8)
SPEECHSUPER_APP_KEY=

# @type=string(minLength=16)
SPEECHSUPER_SECRET_KEY=

# Anthropic Claude API (Scoring LLM for both directions)
# @type=string(minLength=16)
ANTHROPIC_API_KEY=

# Explicit Anthropic model identifiers for evaluation (no silent fallbacks)
# @type=string(minLength=4)
ANTHROPIC_OPUS_MODEL=

# @type=string(minLength=4)
ANTHROPIC_SONNET_MODEL=

# @type=string(minLength=4)
ANTHROPIC_HAIKU_MODEL=
