# Copy file nay thanh bruno/.env roi dien gia tri that (KHONG commit bruno/.env).
# Bruno (GUI extension + CLI) tu nap file nay vao process.env.
# AI tuyet doi KHONG doc noi dung bruno/.env.

# Tai khoan hoc vien seed da ton tai tren moi truong dich (dung cho _setup/login.bru)
SEED_EMAIL=
SEED_PASSWORD=

# Mat khau hop le (8..128 ky tu) dung chung khi tao cac tai khoan test dong
TEST_USER_PASSWORD=

# Tai khoan quan tri vien nam trong ADMIN_EMAILS cua may chu test (tuy chon - phuc vu ACL#41b)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
