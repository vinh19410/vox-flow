meta {
  name: TC-37 POST /api/auth/update-user
  type: http
  seq: 35
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/update-user
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
  Cookie: {{sessionCookie}}
}

body:json {
  {
    "image": "{{VALID_IMAGE_DATA_URL}}"
  }
}

assert {
  # auth: session (relies on Bruno cookie jar after _setup/login)
