meta {
  name: TC-31 GET /api/auth/get-session
  type: http
  seq: 29
}

get {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/get-session
}

headers {
  Cookie: {{sessionCookie}}
}

assert {
  # auth: session (relies on Bruno cookie jar after _setup/login)
  res.status: eq 200
  res.body.session.token: isString
  res.body.user.email: isString
  res.headers['cache-control']: contains no-store
}
