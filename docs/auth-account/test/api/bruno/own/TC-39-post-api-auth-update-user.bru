meta {
  name: TC-39 POST /api/auth/update-user
  type: http
  seq: 37
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/update-user
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
  Cookie: {{sessionCookie}}
}

body:json {
