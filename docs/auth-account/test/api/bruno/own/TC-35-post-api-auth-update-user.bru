meta {
  name: TC-35 POST /api/auth/update-user
  type: http
  seq: 33
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/update-user
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
  Cookie: {{sessionCookie}}
}

body:json {
  {
    "name": "  Ten Da Cap Nhat  "
  }
}

assert {
  # auth: session (relies on Bruno cookie jar after _setup/login)
  res.status: eq 200
  res.body.status: eq true
}
