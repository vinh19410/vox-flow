meta {
  name: TC-05 POST /api/auth/sign-up/email
  type: http
  seq: 5
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-up/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa+{{runId}}@voxflow.local",
    "password": "{{process.env.TEST_USER_PASSWORD}}",
    "name": "Ban Ghi Trung"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 422
  res.body.code: startsWith USER_ALREADY_EXISTS
}
