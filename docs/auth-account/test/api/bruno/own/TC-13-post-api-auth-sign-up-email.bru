meta {
  name: TC-13 POST /api/auth/sign-up/email
  type: http
  seq: 13
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-up/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa.long129+{{runId}}@voxflow.local",
    "password": "{{PASS_129}}",
    "name": "Vuot 128 Ky Tu"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 400
  res.body.code: eq PASSWORD_TOO_LONG
}
