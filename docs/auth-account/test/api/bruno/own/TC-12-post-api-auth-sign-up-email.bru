meta {
  name: TC-12 POST /api/auth/sign-up/email
  type: http
  seq: 12
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-up/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa.bound128+{{runId}}@voxflow.local",
    "password": "{{PASS_128}}",
    "name": "Bien Tren 128"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}
