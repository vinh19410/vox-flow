meta {
  name: TC-03 POST /api/auth/sign-up/email
  type: http
  seq: 3
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-up/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "QA.Trim+{{runId}}@VoxFlow.Local",
    "password": "{{process.env.TEST_USER_PASSWORD}}",
    "name": "  Nguyen Van A  "
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 200
  res.body.user.name: eq Nguyen Van A
  res.body.user.email: eq qa.trim+{{runId}}@voxflow.local
}
