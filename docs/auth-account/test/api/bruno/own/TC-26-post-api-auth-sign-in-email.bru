meta {
  name: TC-26 POST /api/auth/sign-in/email
  type: http
  seq: 25
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-in/email
  body: json
}

headers {
  Origin: {{UNTRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa+{{runId}}@voxflow.local",
    "password": "{{process.env.TEST_USER_PASSWORD}}"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 403
  res.body.code: eq INVALID_ORIGIN
}
