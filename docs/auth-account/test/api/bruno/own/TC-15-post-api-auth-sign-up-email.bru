meta {
  name: TC-15 POST /api/auth/sign-up/email
  type: http
  seq: 15
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-up/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa.name50+{{runId}}@voxflow.local",
    "password": "{{process.env.TEST_USER_PASSWORD}}",
    "name": "{{NAME_50_PADDED}}"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
  bru.setVar('NAME_50_PADDED', '  ' + 'N'.repeat(50) + '  ');
}

assert {
  res.status: eq 200
  res.body.user.name: eq {{NAME_50_TRIMMED}}
}
