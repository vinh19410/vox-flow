meta {
  name: TC-48 GET /trpc/privateData
  type: http
  seq: 46
}

get {
  url: {{AUTH_ACCOUNT_BASE}}/trpc/privateData
}

headers {
  Cookie: {{sessionCookie}}
}

assert {
  # auth: session (relies on Bruno cookie jar after _setup/login)
  res.status: eq 200
  res.body.result.data.message: eq This is private
  res.body.result.data.user.email: isString
}
