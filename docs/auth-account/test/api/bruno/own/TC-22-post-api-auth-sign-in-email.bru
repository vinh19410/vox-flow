meta {
  name: TC-22 POST /api/auth/sign-in/email
  type: http
  seq: 21
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-in/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "qa+{{runId}}@voxflow.local",
    "password": "SaiMatKhau999!"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
  if (!bru.getVar('runId')) {
    bru.setVar('runId', String(Date.now()));
  }
}

assert {
  res.status: eq 401
  res.body.code: eq INVALID_EMAIL_OR_PASSWORD
}
