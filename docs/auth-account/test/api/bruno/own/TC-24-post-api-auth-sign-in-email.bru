meta {
  name: TC-24 POST /api/auth/sign-in/email
  type: http
  seq: 23
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/sign-in/email
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

body:json {
  {
    "email": "email-sai-dinh-dang",
    "password": "{{process.env.TEST_USER_PASSWORD}}"
  }
}

script:pre-request {
  try { bru.cookies.jar().clear(); } catch (e) {}
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_EMAIL
}
