meta {
  name: TC-42 POST /api/auth/update-user
  type: http
  seq: 40
}

post {
  url: {{AUTH_ACCOUNT_BASE}}/api/auth/update-user
  body: json
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
  Cookie: {{sessionCookie}}
}

body:json {
  {
    "image": "http://example.com/a.png"
  }
}

assert {
  # auth: session (relies on Bruno cookie jar after _setup/login)
  res.status: eq 400
  res.body.code: eq INVALID_IMAGE
}
